# Copy to .env and fill in. .env is gitignored.

DATABASE_URL=postgresql+psycopg://alphamarket:alphamarket@localhost:5432/alphamarket

# Session signing secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Kalshi: "demo" or "prod". Stay on demo until M5.
KALSHI_ENV=demo
KALSHI_KEY_ID=
# Path to the RSA private key PEM downloaded from Kalshi when you created the API key.
# Keep it under keys/ (gitignored).
KALSHI_PRIVATE_KEY_PATH=keys/kalshi_demo.pem

# Credential vault master key (Fernet). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=

# true behind HTTPS at deploy
SECURE_COOKIES=false
PUBLIC_BASE_URL=http://localhost:8000

# Demo build for the accelerator: serves labelled SAMPLE pages (tailing, portfolio,
# feed) and pads the marketplace. Never on for real users; preflight refuses it.
DEMO_MODE=false

# ---- account security (P3). Dev defaults below; preflight requires the prod values.
# Inbound rate limits: memory (dev, per process) | postgres (prod, shared).
RATE_LIMITER=memory
# true only when the app is reachable solely through Cloudflare/Fly (client IP header).
TRUST_PROXY_HEADERS=false
# Transactional email: console (dev; logs the message) | smtp (prod: Postmark, SES, Resend).
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Koine <no-reply@localhost>
# Breached-password check against HIBP (k-anonymity range API). true in prod.
HIBP_ENABLED=false
