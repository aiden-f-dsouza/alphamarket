# Copy to .env and fill in. .env is gitignored.

DATABASE_URL=postgresql+psycopg://alphamarket:alphamarket@localhost:5432/alphamarket

# Session signing secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Kalshi: "demo" or "prod". Stay on demo until M5.
KALSHI_ENV=demo
KALSHI_KEY_ID=
# Path to the RSA private key PEM downloaded from Kalshi when you created the API key.
# Keep it under keys/ (gitignored).
KALSHI_PRIVATE_KEY_PATH=keys/kalshi_demo.pem

# Credential vault master key (Fernet). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=

# true behind HTTPS at deploy
SECURE_COOKIES=false
PUBLIC_BASE_URL=http://localhost:8000

# Demo build for the accelerator: serves labelled SAMPLE pages (tailing, portfolio,
# feed) and pads the marketplace. Never on for real users; preflight refuses it.
DEMO_MODE=false

# ---- p3-vault: credential vault v2 (vault.py) ----
# VAULT_KEY may list several Fernet keys, newest first ("new,old") during a
# rotation (scripts/rotate_credentials.py). KEY_WRAPPER=local wraps each
# record's data key with VAULT_KEY (dev only; preflight refuses it in prod).
# KEY_WRAPPER=aws_kms wraps with KMS (needs AWS credentials in the env; IAM:
# kms:GenerateDataKey, Decrypt, Encrypt, ReEncrypt*, DescribeKey). An alias is
# resolved to its key ARN, so re-pointing it is a rotation: run the script.
KEY_WRAPPER=local
KMS_KEY_ID=
AWS_REGION=
# Trusted proxy header holding the client IP for audit rows ("fly-client-ip").
CLIENT_IP_HEADER=
